# Copy to .env.local to point the UI at a backend other than local dev.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_API_BASE=http://127.0.0.1:8000

# Road-routing engine used to draw vehicle paths on real roads (Vehicles page).
# Defaults to the public OSRM demo server - fine for a prototype, not production.
# Point at a self-hosted OSRM (or a backend proxy) with no code change.
# VITE_OSRM_URL=https://router.project-osrm.org

# Copy to .env and fill in. backend/.env is gitignored and must stay that way.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/ner_logix

# --- JWT ------------------------------------------------------------------
# Must be 32+ characters. Anyone who knows this can mint a valid admin token,
# so treat it like a password and use a different one in production.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Gmail (OTP delivery) -------------------------------------------------
# GMAIL_APP_PASSWORD is the 16-character App Password from
# myaccount.google.com/apppasswords -- NOT your Gmail login password.
# Requires 2-Step Verification to be enabled on the account first.
# Enter it without spaces.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=NER-LOGIX
